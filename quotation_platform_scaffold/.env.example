# Copy to .env (docker-compose reads it automatically) or export these
# directly in your shell / hosting provider's env var settings.

# --- required outside local dev ---
JWT_SECRET_KEY=                  # generate: python -c "import secrets; print(secrets.token_hex(32))"

# --- database ---
DATABASE_URL=sqlite:///./quotation.db      # or postgresql://user:pass@host:5432/dbname
AUTO_CREATE_TABLES=true                    # set false in production; run `alembic upgrade head` instead

# --- CORS: the frontend origin(s) allowed to call this API ---
CORS_ORIGINS=http://localhost:5173

# --- local file paths (dev defaults; ignored if STORAGE_BACKEND=s3) ---
QUOTE_OUTPUT_DIR=
ASSET_DIR=

# --- asset storage: local (default) or s3 ---
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=                 # only for non-AWS S3-compatible services (MinIO, Spaces, ...)
S3_PUBLIC_BASE_URL=              # required for uploaded logos to actually render

# --- Stripe billing (leave unset to disable billing gating's checkout endpoint) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
